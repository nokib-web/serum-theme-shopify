    "faq_home_section": {
      "type": "collapsible-content",
      "blocks": {
        "faq_item_1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Are Nura Essentials products suitable for all skin types?",
            "icon": "check_circle",
            "filled_icon": false,
            "row_content": "<p>Yes! Our formulas are dermatologist-tested, hypoallergenic, and non-comedogenic—crafted to nourish sensitive, dry, combination, and oily skin types alike.</p>",
            "page": ""
          }
        },
        "faq_item_2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How soon can I expect to see visible skin results?",
            "icon": "check_circle",
            "filled_icon": false,
            "row_content": "<p>Most customers report noticeable skin hydration, glow, and smoother texture within 7 to 14 days of daily use. Firming and fine-line improvements typically show in 3–4 weeks.</p>",
            "page": ""
          }
        },
        "faq_item_3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How and when should I apply the peptide serum?",
            "icon": "check_circle",
            "filled_icon": false,
            "row_content": "<p>Apply 3–4 drops onto freshly cleansed, slightly damp skin twice daily (morning and night). Pat gently into face and neck before applying your favorite moisturizer and SPF.</p>",
            "page": ""
          }
        },
        "faq_item_4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can Nura Essentials serums be layered with other skincare products?",
            "icon": "check_circle",
            "filled_icon": false,
            "row_content": "<p>Absolutely. Our lightweight, fast-absorbing serums layer seamlessly beneath moisturizers, facial oils, and sunscreen without pilling or causing heavy buildup.</p>",
            "page": ""
          }
        },
        "faq_item_5": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Are your skincare products cruelty-free and clean-formulated?",
            "icon": "check_circle",
            "filled_icon": false,
            "row_content": "<p>Yes, 100%. Nura Essentials is proud to be cruelty-free, paraben-free, sulfate-free, and formulated without synthetic dyes or harsh synthetic fragrance.</p>",
            "page": ""
          }
        },
        "faq_item_6": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What makes copper peptides so beneficial for the skin?",
            "icon": "check_circle",
            "filled_icon": false,
            "row_content": "<p>Copper peptides promote collagen and elastin synthesis, support skin barrier recovery, reduce visible redness, and help maintain youthful elasticity and firmness.</p>",
            "page": ""
          }
